FROM python:3.13-slim AS api-runner

# Bring in the uv binary (pinned; bump manually — keep in sync with CI and pyproject)
COPY --from=ghcr.io/astral-sh/uv:0.11.21 /uv /uvx /bin/

WORKDIR /app

# No build toolchain or system GDAL: every dependency (dev group included) installs
# from a prebuilt wheel, for linux/amd64 and linux/arm64, and rasterio and pyogrio
# bundle their own GDAL. That GDAL links against the system libexpat, the only
# system library needed.
RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 \
    && rm -rf /var/lib/apt/lists/*

# uv configuration:
# - keep the project environment outside /app so the dev bind-mount
#   (`-v $(pwd):/app`) does not shadow the installed dependencies
# - use the interpreter provided by the base image (no downloads)
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

# Copy only the dependency manifests first for better layer caching.
# The dev image includes the `dev` dependency-group (pytest, ruff, ...). `--no-build`
# fails instead of compiling a package that has no wheel.
COPY ./pyproject.toml ./uv.lock ./.python-version ./
RUN uv sync --frozen --no-build

# The source code will be mounted as a volume in development
# This allows for hot reloading of the code

EXPOSE 8000

# Use development entrypoint that enables hot reloading
CMD ["uv", "run", "--frozen", "fastapi", "dev", "./app/main.py", "--host", "0.0.0.0", "--port", "8000"]
