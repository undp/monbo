# Build stage for API
FROM --platform=linux/amd64 python:3.13-slim AS api-builder

# Bring in the uv binary (pinned; bump manually — keep in sync with CI and pyproject)
COPY --from=ghcr.io/astral-sh/uv:0.11.21 /uv /uvx /bin/

WORKDIR /app

# No build toolchain: every dependency installs from a prebuilt wheel, and rasterio
# and pyogrio bundle their own GDAL. The API doesn't use a system GDAL.

# uv configuration: build a self-contained environment at /opt/venv using the
# interpreter provided by the base image (no downloads).
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

# Copy only the dependency manifests first for better caching.
# Production install excludes the `dev` dependency-group (`--no-dev`), fails if
# pyproject.toml and uv.lock are inconsistent (`--frozen`), and fails if any package
# would have to be compiled (`--no-build`) instead of needing a toolchain here.
COPY ./pyproject.toml ./uv.lock ./.python-version ./
RUN uv sync --frozen --no-dev --no-build

# Copy source code
COPY ./app ./app

# Final stage
FROM --platform=linux/amd64 python:3.13-slim AS api-runner
WORKDIR /app

# Create non-root user
# Fixed uid/gid: the Azure Files mount maps file ownership to this user
# (mountOptions uid=10001,gid=10001), so it must not depend on the image build.
RUN groupadd -r -g 10001 appuser && useradd -r -u 10001 -g appuser -s /bin/false appuser

# The only system library the wheels need: the GDAL bundled in rasterio's and pyogrio's
# wheels links against the system libexpat (Python's own pyexpat doesn't cover it).
RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 \
    && rm -rf /var/lib/apt/lists/*

# Copy the pre-built virtual environment (root-owned, read-only for the app user) and
# the application code, owned by the app user from the start (no `chown -R` layer
# duplicating it).
COPY --from=api-builder /opt/venv /opt/venv
COPY --from=api-builder --chown=appuser:appuser /app/app ./app

# Put the virtualenv on PATH so `uvicorn` resolves to the installed one
ENV PATH="/opt/venv/bin:$PATH"

# Switch to non-root user
USER appuser

EXPOSE 8000

# Set the entrypoint
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
