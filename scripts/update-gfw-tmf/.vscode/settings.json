{
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
  "python.formatting.provider": "none",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  },
  "black-formatter.interpreter": ["${workspaceFolder}/venv/bin/python"],
  "black-formatter.path": ["${workspaceFolder}/venv/bin/black"],
  "black-formatter.args": ["--skip-string-normalization"],
  "flake8.args": ["--max-line-length=120", "--ignore=E203,E266,E501,W503"],
  "flake8.executable": "${workspaceFolder}/scripts/update-gfw-tmf/venv/bin/flake8",
  "flake8.run": "onType"
}
