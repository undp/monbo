# Copy to azure/deploy.env (gitignored) and fill in. Used by azure/deploy.sh.

# Azure resources
# Required. Find it with: az account list -o table
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=monbo-test
LOCATION=eastus2
# Globally unique, lowercase alphanumeric, 5-50 chars
ACR_NAME=
CONTAINERAPPS_ENV=monbo-env
API_APP_NAME=monbo-api
FRONT_APP_NAME=monbo-front

# Image tag (defaults to the current git short SHA)
# TAG=

# Google Maps Platform
GCP_MAPS_PLATFORM_API_KEY=
GCP_MAPS_PLATFORM_SIGNATURE_SECRET=
# Browser-exposed key for the frontend (defaults to GCP_MAPS_PLATFORM_API_KEY)
# FRONT_GCP_MAPS_PLATFORM_API_KEY=

# App settings
OVERLAP_THRESHOLD_PERCENTAGE=1
DEFORESTATION_THRESHOLD_PERCENTAGE=2
SHOW_TESTING_ENVIRONMENT_WARNING=true
MAX_REQUESTS_FOR_SATELLITE_BACKGROUND=90
# Landing page "Your country could be next" card: an https: URL or a mailto: link.
# Leave it empty to hide the card.
# CONTACT_URL=mailto:monbo@example.org

# Container sizes (valid Container Apps pairs: 0.5/1Gi, 1/2Gi, 2/4Gi)
# API_CPU=1
# API_MEMORY=2Gi
# FRONT_CPU=0.5
# FRONT_MEMORY=1Gi

# Persistent layer storage (Azure Files). Required: the API image carries no layers,
# so the API reads them from this share, mounted at /mnt/maps. `./azure/deploy.sh
# storage` creates the share, its backups and a delete lock. Seed it
# (`./azure/deploy.sh seed`) before the first deploy (docs/suggested_deployment.md).
# Separate from AZURE_RESOURCE_GROUP on purpose: `destroy` never touches it.
DATA_RESOURCE_GROUP=monbo-data
# Globally unique, lowercase alphanumeric, 3-24 chars
STORAGE_ACCOUNT_NAME=
# MAPS_SHARE_NAME=maps
# BACKUP_VAULT_NAME=monbo-backup

# Layers admin (optional, needs STORAGE_ACCOUNT_NAME and the per-country layout): a
# random secret of at least 32 characters that signs the admin sessions, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Each country's admin passkey is managed with `./azure/deploy.sh countries`.
ADMIN_SESSION_SECRET=
# Only when the frontend has a custom domain (defaults to its Container Apps URL):
# ADMIN_ALLOWED_ORIGIN=https://monbo.example.org
