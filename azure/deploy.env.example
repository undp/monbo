# Copy to azure/deploy.env (gitignored) and fill in. Used by azure/deploy.sh.

# Azure resources
# Required. Find it with: az account list -o table
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=monbo-test
LOCATION=eastus2
# Globally unique, lowercase alphanumeric, 5-50 chars
ACR_NAME=
CONTAINERAPPS_ENV=monbo-env
API_APP_NAME=monbo-api
FRONT_APP_NAME=monbo-front

# Image tag (defaults to the current git short SHA)
# TAG=

# Google Maps Platform
GCP_MAPS_PLATFORM_API_KEY=
GCP_MAPS_PLATFORM_SIGNATURE_SECRET=
# Browser-exposed key for the frontend (defaults to GCP_MAPS_PLATFORM_API_KEY)
# FRONT_GCP_MAPS_PLATFORM_API_KEY=

# App settings
OVERLAP_THRESHOLD_PERCENTAGE=1
DEFORESTATION_THRESHOLD_PERCENTAGE=2
SHOW_TESTING_ENVIRONMENT_WARNING=true
MAX_REQUESTS_FOR_SATELLITE_BACKGROUND=90

# Container sizes (valid Container Apps pairs: 0.5/1Gi, 1/2Gi, 2/4Gi)
# API_CPU=1
# API_MEMORY=2Gi
# FRONT_CPU=0.5
# FRONT_MEMORY=1Gi
