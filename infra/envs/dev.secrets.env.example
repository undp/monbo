# Copy to infra/envs/dev.secrets.env (git-ignored) for infra/deploy.sh and
# tools/layers-ops. In CI the same names come from the GitHub Environment's secrets.

# The Azure subscription of this environment (read by Terraform, az and the scripts).
ARM_SUBSCRIPTION_ID=

# Google Maps Platform (the API's satellite backgrounds; URL signing).
TF_VAR_gcp_maps_platform_api_key=
TF_VAR_gcp_maps_platform_signature_secret=
# Browser-exposed key for the frontend; leave it out to reuse the API key.
# TF_VAR_front_gcp_maps_platform_api_key=

# Layers admin: a random secret of at least 32 characters that signs the admin
# sessions; leave it out to keep the admin off. Changing it signs every admin out.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TF_VAR_admin_session_secret=
