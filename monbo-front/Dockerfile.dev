FROM node:24-alpine AS frontend-runner
WORKDIR /app

# Use the exact pnpm version declared by `packageManager` via Corepack instead
# of installing a mutable global; `npm install -g pnpm` would pull whatever is
# latest at image-build time and silently drift from the committed lockfile.
RUN corepack enable

# Copy package files for dependency installation
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Set environment variables
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=development
# Variables for better performance
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true
ENV NEXT_WEBPACK_USEPOLLING=1

# Expose development port
EXPOSE 3000

# Start development server with hot-reloading
CMD ["pnpm", "run", "dev"]