# Build stage for API
FROM --platform=linux/amd64 python:3.11-slim AS api-builder
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gdal-bin \
    libgdal-dev \
    libexpat1 \
    gcc \
    g++ \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Set GDAL environment variables
ENV CPLUS_INCLUDE_PATH=/usr/include/gdal
ENV C_INCLUDE_PATH=/usr/include/gdal

# Copy only package files first for better caching
COPY ./requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY ./app ./app

# Validate raster files are actual data (not Git LFS pointers)
RUN for f in app/maps/layers/rasters/*.tif; do \
      [ -f "$f" ] || continue; \
      if head -c 44 "$f" | grep -q "version https://git-lfs.github.com/spec/v1"; then \
        echo "ERROR: '$f' is a Git LFS pointer, not actual raster data." >&2; \
        echo "Run 'git lfs install && git lfs pull' before building the Docker image." >&2; \
        exit 1; \
      fi; \
    done

# Final stage
FROM --platform=linux/amd64 python:3.11-slim AS api-runner
WORKDIR /app

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser -s /bin/false appuser

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gdal-bin \
    libgdal-dev \
    libexpat1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages and application code
COPY --from=api-builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=api-builder /usr/local/bin/uvicorn /usr/local/bin/uvicorn
COPY --from=api-builder /app/app ./app

# Set correct permissions
RUN chown -R appuser:appuser ./app && \
    chmod -R 755 ./app

# Switch to non-root user
USER appuser

EXPOSE 8000

# Set the entrypoint
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]