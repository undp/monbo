# Build stage for API
FROM --platform=linux/amd64 python:3.11-slim AS api-builder

# Bring in the uv binary (pinned; bump manually — keep in sync with CI and pyproject)
COPY --from=ghcr.io/astral-sh/uv:0.11.21 /uv /uvx /bin/

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gdal-bin \
    libgdal-dev \
    libexpat1 \
    gcc \
    g++ \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Set GDAL environment variables
ENV CPLUS_INCLUDE_PATH=/usr/include/gdal
ENV C_INCLUDE_PATH=/usr/include/gdal

# uv configuration: build a self-contained environment at /opt/venv using the
# interpreter provided by the base image (no downloads).
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

# Copy only the dependency manifests first for better caching.
# Production install excludes the `dev` dependency-group (`--no-dev`) and fails
# if pyproject.toml and uv.lock are inconsistent (`--frozen`).
COPY ./pyproject.toml ./uv.lock ./.python-version ./
RUN uv sync --frozen --no-dev

# Copy source code
COPY ./app ./app

# Final stage
FROM --platform=linux/amd64 python:3.11-slim AS api-runner
WORKDIR /app

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser -s /bin/false appuser

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gdal-bin \
    libgdal-dev \
    libexpat1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy the pre-built virtual environment and application code
COPY --from=api-builder /opt/venv /opt/venv
COPY --from=api-builder /app/app ./app

# Put the virtualenv on PATH so `uvicorn` resolves to the installed one
ENV PATH="/opt/venv/bin:$PATH"

# Set correct permissions
RUN chown -R appuser:appuser ./app && \
    chmod -R 755 ./app

# Switch to non-root user
USER appuser

EXPOSE 8000

# Set the entrypoint
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
