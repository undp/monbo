GCP_MAPS_PLATFORM_API_KEY=your_google_api_key
GCP_MAPS_PLATFORM_SIGNATURE_SECRET=your_signature_secret
OVERLAP_THRESHOLD_PERCENTAGE=1

# Directory with the layers index, metadata and rasters. Empty = app/maps (the
# Git-tracked layers). To try the layers admin locally without touching Git-tracked
# files, copy app/maps to .local-maps and set MAPS_ROOT=.local-maps
MAPS_ROOT=

# Layers admin. It stays off (no /admin routes) unless both values are set.
# Generate them with: uv run python -m app.modules.admin.passkey
# (it also prints the passkey to log in with; keep that one out of this file)
ADMIN_PASSKEY_HASH=
ADMIN_SESSION_SECRET=
# Minutes an admin session lasts
ADMIN_SESSION_TTL_MINUTES=60
# Frontend origin allowed to call the admin routes. Empty = no Origin check
ADMIN_ALLOWED_ORIGIN=http://localhost:3000
# Largest raster upload, in MB
ADMIN_MAX_UPLOAD_MB=500
# Local directory where raster uploads are staged and processed
ADMIN_STAGING_DIR=/tmp/monbo-staging
