GCP_MAPS_PLATFORM_API_KEY=your_google_api_key
GCP_MAPS_PLATFORM_SIGNATURE_SECRET=your_signature_secret
OVERLAP_THRESHOLD_PERCENTAGE=1

# Directory with the layers. Empty = app/maps (the Git-tracked layers, in the flat
# layout, read-only). To try the layers admin locally without touching Git-tracked
# files, migrate them to the per-country layout and set MAPS_ROOT=.local-maps:
#   uv run python -m app.modules.layers.migrate_countries --source app/maps --target .local-maps
# (it prints each country's admin passkey; keep them out of this file)
MAPS_ROOT=

# Layers admin. It stays off (no /admin routes) unless this is set and MAPS_ROOT has
# the per-country layout. At least 32 random characters; changing it signs every
# admin out. Countries and their passkeys: uv run python -m app.modules.admin.countries
ADMIN_SESSION_SECRET=
# Minutes an admin session lasts
ADMIN_SESSION_TTL_MINUTES=60
# Frontend origin allowed to call the admin routes. Empty = no Origin check
ADMIN_ALLOWED_ORIGIN=http://localhost:3000
# Largest raster upload, in MB
ADMIN_MAX_UPLOAD_MB=500
# Local directory where raster uploads are staged and processed
ADMIN_STAGING_DIR=/tmp/monbo-staging
